generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  DRIVER
}

enum VehicleStatus {
  OFFLINE
  ONLINE
}

enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PoolStatus {
  ACTIVE
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole

  vehicle       Vehicle?
  rideRequests  RideRequest[]
  statusChanges RideStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id       String        @id @default(uuid())
  driverId String        @unique
  name     String
  capacity Int           @default(3)
  status   VehicleStatus @default(OFFLINE)

  driver User   @relation(fields: [driverId], references: [id])
  pools  Pool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RideRequest {
  id              String     @id @default(uuid())
  passengerId     String
  pickupZone      String
  destinationZone String
  requestedSeats  Int        @default(1)
  estimatedFare   Int
  status          RideStatus @default(REQUESTED)

  passenger      User                @relation(fields: [passengerId], references: [id])
  poolMembership PoolMember?
  statusHistory  RideStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passengerId])
  @@index([status])
}

model Pool {
  id        String     @id @default(uuid())
  vehicleId String
  status    PoolStatus @default(ACTIVE)

  vehicle Vehicle      @relation(fields: [vehicleId], references: [id])
  members PoolMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}

model PoolMember {
  id            String @id @default(uuid())
  poolId        String
  rideRequestId String @unique
  seats         Int
  fare          Int

  pool        Pool        @relation(fields: [poolId], references: [id])
  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id])

  joinedAt DateTime @default(now())

  @@index([poolId])
}

model RideStatusHistory {
  id            String      @id @default(uuid())
  rideRequestId String
  fromStatus    RideStatus?
  toStatus      RideStatus
  changedBy     String

  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id])
  changedByUser User        @relation(fields: [changedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([rideRequestId])
  @@index([changedBy])
}
